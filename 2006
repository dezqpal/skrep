-- [[ 3. WEBHOOK LOGIC ]]
local function SendWebhook(status)
    local data = {
        ["embeds"] = {{
            ["title"] = "PRIMO EXECUTOR LOG",
            ["description"] = string.format(
                "**Status:** %s\n**Player:** %s\n**User ID:** %d\n**Game:** %s",
                status, 
                Player.Name, 
                Player.UserId, 
                game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
            ),
            ["color"] = (status == "ACCESS GRANTED" and 65280 or 16711680),
            ["thumbnail"] = {
                ["url"] = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. Player.UserId .. "&width=420&height=420&format=png"
            },
            ["footer"] = {["text"] = "Primo Security System"}
        }}
    }
    
    pcall(function()
        local payload = HttpService:JSONEncode(data)
        local request = http_request or request or HttpPost or (syn and syn.request)
        if request then
            request({
                Url = WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end
    end)
end

